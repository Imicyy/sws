		<script>
		  // Tab switching and status confirm handlers
		  $(function(){
		    let activeStatus = 'Active';
		    let currentPage = 1;
		    const noUsersRow = $('#no-users-row');
		    const allUserRows = $('.user-row');

		    $('#userTabs .nav-link').on('click', function(e){
		      e.preventDefault();
		      $('#userTabs .nav-link').removeClass('active');
		      $(this).addClass('active');
		      activeStatus = $(this).data('status');
		      currentPage = 1;
		      applyFiltersAndPagination();
		    });

		    $('#userSearchInput').on('input', function() {
		      currentPage = 1;
		      applyFiltersAndPagination();
		    });

		    $('#roleFilter').on('change', function() {
		      currentPage = 1;
		      applyFiltersAndPagination();
		    });

		    $('#pageSize').on('change', function() {
		      currentPage = 1;
		      applyFiltersAndPagination();
		    });

		    function applyFiltersAndPagination() {
		      const searchTerm = ($('#userSearchInput').val() || '').toLowerCase().trim();
		      const selectedRole = $('#roleFilter').val();
		      const perPage = parseInt($('#pageSize').val(), 10) || 10;

		      allUserRows.hide();
		      const filtered = allUserRows.filter(function() {
		        const $row = $(this);
		        const isStatusMatch = $row.hasClass('status-' + activeStatus);
		        if (!isStatusMatch) return false;

		        const roleText = ($row.children('td').eq(2).text() || '').trim();
		        const rowText = ($row.text() || '').toLowerCase();
		        const isRoleMatch = !selectedRole || roleText === selectedRole;
		        const isSearchMatch = !searchTerm || rowText.includes(searchTerm);

		        return isRoleMatch && isSearchMatch;
		      });

		      const total = filtered.length;
		      const totalPages = Math.max(1, Math.ceil(total / perPage));
		      if (currentPage > totalPages) currentPage = totalPages;

		      const start = total === 0 ? 0 : ((currentPage - 1) * perPage) + 1;
		      const end = Math.min(currentPage * perPage, total);

		      if (total > 0) {
		        filtered.slice(start - 1, end).show();
		      }

		      $('#paginationInfo').text('Showing ' + start + '-' + end + ' of ' + total + ' users');
		      renderPaginationControls(totalPages);

		      if (noUsersRow.length) {
		        noUsersRow.toggle(total === 0);
		      }
		    }

		    function renderPaginationControls(totalPages) {
		      const $controls = $('#paginationControls');
		      $controls.empty();

		      const prevDisabled = currentPage === 1 ? 'disabled' : '';
		      $controls.append('<button type="button" class="btn btn-light ' + prevDisabled + '" data-page="prev">Prev</button>');

		      const startPage = Math.max(1, currentPage - 2);
		      const endPage = Math.min(totalPages, startPage + 4);
		      for (let i = startPage; i <= endPage; i++) {
		        const activeClass = i === currentPage ? 'btn-primary' : 'btn-light';
		        $controls.append('<button type="button" class="btn ' + activeClass + '" data-page="' + i + '">' + i + '</button>');
		      }

		      const nextDisabled = currentPage === totalPages ? 'disabled' : '';
		      $controls.append('<button type="button" class="btn btn-light ' + nextDisabled + '" data-page="next">Next</button>');
		    }

		    $(document).on('click', '#paginationControls button', function() {
		      const pageAction = $(this).data('page');
		      if (pageAction === 'prev' && currentPage > 1) {
		        currentPage--;
		      } else if (pageAction === 'next') {
		        currentPage++;
		      } else if (!isNaN(Number(pageAction))) {
		        currentPage = Number(pageAction);
		      }
		      applyFiltersAndPagination();
		    });

		    applyFiltersAndPagination();

		    // Handle activate/deactivate clicks
		    $(document).on('click', '.status-btn', function(e){
		      e.preventDefault();
		      var action = $(this).data('action');
		      var form = $(this).closest('form');
		      if (action === 'deactivate'){
		        Swal.fire({
		          title: 'Confirm Deactivation',
		          text: 'Make sure you want to deactivate this account.',
		          icon: 'warning',
		          showCancelButton: true,
		          confirmButtonText: 'Yes, deactivate',
		          cancelButtonText: 'Cancel'
		        }).then((result) => {
		          if (result.isConfirmed) {
		            form.submit();
		          }
		        });
		      } else {
		        // Activate - no confirmation
		        form.submit();
		      }
		    });
		  });

		  $(document).on('click', '.open-edit', function() {
			const id = $(this).data('id');
			const name = $(this).data('name');
			const email = $(this).data('email');
			const role = $(this).data('role');
			const barangayId = $(this).data('barangay-id');
			const status = $(this).data('status');

			$('#edit-user-id').val(id);
			$('#edit-username').val(name);
			$('#edit-email').val(email);
			$('#edit-role').val(role);
			$('#edit-password').val('');
			$('#edit-confirm').val('');
			$('#edit-barangay-id').val(barangayId || '');
			toggleEditBarangayDropdown();
			$('#edit-status').val(status);

			$('#edit-modal').show();
		  });

		  function toggleEditBarangayDropdown() {
			const selectedRole = $('#edit-role').val();
			const barangayRow = $('#edit-barangay-row');
			const barangaySelect = $('#edit-barangay-id');

			if (selectedRole === 'Barangay') {
			  barangayRow.show();
			  barangaySelect.prop('required', true);
			} else {
			  barangayRow.hide();
			  barangaySelect.prop('required', false);
			  barangaySelect.val('');
			}
		  }

		  $('#edit-role').on('change', function() {
			toggleEditBarangayDropdown();
		  });

		  $('#edit-user-form').on('submit', function(e) {
			const password = ($('#edit-password').val() || '').trim();
			const confirmPassword = ($('#edit-confirm').val() || '').trim();

			// Allow updating other fields without changing password.
			if (!password && !confirmPassword) {
			  return;
			}

			if (!password || !confirmPassword) {
			  e.preventDefault();
			  Swal.fire({
				icon: 'error',
				title: 'Password fields required',
				text: 'Enter both New Password and Confirm Password, or leave both blank.'
			  });
			  return;
			}

			if (password.length < 6) {
			  e.preventDefault();
			  Swal.fire({
				icon: 'error',
				title: 'Password too short',
				text: 'New password must be at least 6 characters.'
			  });
			  return;
			}

			if (password !== confirmPassword) {
			  e.preventDefault();
			  Swal.fire({
				icon: 'error',
				title: 'Passwords do not match',
				text: 'Please make sure both password fields match.'
			  });
			}
		  });

		  $('.close-btn, .cancel-btn').on('click', function(){
			$('#edit-modal').hide();
		  });

		  $(window).on('click', function(e){
			if (e.target.id === 'edit-modal') {
			  $('#edit-modal').hide();
			}
		  });
		</script>

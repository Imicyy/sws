													<input id="pwdLogsSearch" class="form-control form-control-sm" type="search" placeholder="Type to filter…" style="width: 240px;">
												</div>
												<div class="d-flex align-items-center" style="gap: 8px;">
													<label class="mb-0 text-muted" for="pwdLogsPageSize" style="font-size: 12px;">Rows</label>
													<select id="pwdLogsPageSize" class="form-control form-control-sm" style="width: 90px;">
														<option>5</option>
														<option selected>10</option>
														<option>25</option>
														<option>50</option>
													</select>
												</div>
											</div>

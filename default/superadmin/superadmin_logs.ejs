		<!-- Global site tag (gtag.js) - Google Analytics -->
		<script async="" src="https://www.googletagmanager.com/gtag/js?id=UA-23581568-13"></script>
		<script>
			window.dataLayer = window.dataLayer || [];

			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', 'UA-23581568-13');
		</script>
		<script id="pwdLogsDataJson" type="application/json"><%- JSON.stringify((typeof pwdLogs !== 'undefined' && pwdLogs) ? pwdLogs : []) %></script>
		<script id="seniorLogsDataJson" type="application/json"><%- JSON.stringify((typeof seniorLogs !== 'undefined' && seniorLogs) ? seniorLogs : []) %></script>
		<script>
			(function () {
				const pwdLogsData = JSON.parse(document.getElementById('pwdLogsDataJson')?.textContent || '[]');
				const seniorLogsData = JSON.parse(document.getElementById('seniorLogsDataJson')?.textContent || '[]');

				function safeText(v) {
					if (v == null || v === '') return '—';
					return String(v)
						.replace(/&/g, '&amp;')
						.replace(/</g, '&lt;')
						.replace(/>/g, '&gt;')
						.replace(/"/g, '&quot;')
						.replace(/'/g, '&#39;');
				}

				function normalize(v) {
					return String(v || '').trim().toLowerCase();
				}

				function toDateOrNull(v) {
					if (!v) return null;
					const d = new Date(v);
					return Number.isNaN(d.getTime()) ? null : d;
				}

				function formatDateTime(v) {
					const d = toDateOrNull(v);
					return d ? d.toLocaleString() : '—';
				}

				function buildEditRowsTable(rows, typeLabel) {
					if (!rows.length) {
						return '<div class="text-muted mb-2">No ' + typeLabel + ' edits found for this login.</div>';
					}
					const body = rows.map(function (row) {
						const idValue = typeLabel === 'PWD' ? row.pwd_id : row.senior_id;
						return '<tr>' +
							'<td>' + safeText(row.record_name) + '</td>' +
							'<td>' + safeText(idValue) + '</td>' +
							'<td>' + safeText(row.field) + '</td>' +
							'<td style="max-width:220px;word-break:break-word;">' + safeText(row.old_value) + '</td>' +
							'<td style="max-width:220px;word-break:break-word;">' + safeText(row.new_value) + '</td>' +
							'<td>' + safeText(row.edited_by) + '</td>' +
							'<td>' + safeText(formatDateTime(row.edited_at)) + '</td>' +
						'</tr>';
					}).join('');

					return '<table class="table table-sm table-striped table-bordered mb-0">' +
						'<thead class="thead-light"><tr>' +
							'<th>Record</th><th>' + (typeLabel === 'PWD' ? 'PWD ID' : 'Senior ID') + '</th><th>Field</th><th>Previous value</th><th>New value</th><th>Edited by</th><th>Edited at</th>' +
						'</tr></thead>' +
						'<tbody>' + body + '</tbody>' +
					'</table>';
				}

				function filterEditsForLogin(loggedInAt, email, name) {
					const loginDate = toDateOrNull(loggedInAt);
					if (!loginDate) return { pwd: [], senior: [] };
					const windowStart = loginDate.getTime();
					const windowEnd = windowStart + (24 * 60 * 60 * 1000);
					const emailNorm = normalize(email);
					const nameNorm = normalize(name);

					function isInWindow(editAt) {
						const editDate = toDateOrNull(editAt);
						if (!editDate) return false;
						const t = editDate.getTime();
						return t >= windowStart && t <= windowEnd;
					}

					function isSameEditor(editedBy) {
						const editorNorm = normalize(editedBy);
						if (!editorNorm) return false;
						return (emailNorm && editorNorm === emailNorm) || (nameNorm && editorNorm === nameNorm);
					}

					const pwd = pwdLogsData.filter(function (row) {
						return isSameEditor(row.edited_by) && isInWindow(row.edited_at);
					});
					const senior = seniorLogsData.filter(function (row) {
						return isSameEditor(row.edited_by) && isInWindow(row.edited_at);
					});
					return { pwd: pwd, senior: senior };
				}

				function setupLoginDetailsModal() {
					const modalEl = document.getElementById('loginLogDetailsModal');
					const metaEl = document.getElementById('loginLogDetailsMeta');
					const pwdContainer = document.getElementById('loginDetailsPwdContainer');
					const seniorContainer = document.getElementById('loginDetailsSeniorContainer');
					if (!modalEl || !metaEl || !pwdContainer || !seniorContainer) return;

					const $modal = $('#loginLogDetailsModal');
					$modal.appendTo('body');

					$modal.on('show.bs.modal', function (event) {
						const btn = event.relatedTarget;
						if (!btn) return;
						const loginAt = btn.getAttribute('data-login-at') || '';
						const email = btn.getAttribute('data-login-email') || '';
						const name = btn.getAttribute('data-login-name') || '';
						const userId = btn.getAttribute('data-login-user-id') || '';
						const filtered = filterEditsForLogin(loginAt, email, name);

						metaEl.innerHTML = '<strong>User:</strong> ' + safeText(name || email || userId || '—') +
							' &nbsp;|&nbsp; <strong>Email:</strong> ' + safeText(email || '—') +
							' &nbsp;|&nbsp; <strong>Login time:</strong> ' + safeText(formatDateTime(loginAt));
						pwdContainer.innerHTML = buildEditRowsTable(filtered.pwd, 'PWD');
						seniorContainer.innerHTML = buildEditRowsTable(filtered.senior, 'Senior');
					});

					$modal.on('hidden.bs.modal', function () {
						$('.modal-backdrop').remove();
						$('body').removeClass('modal-open').css('padding-right', '');
					});
				}

				function setupTablePager(opts) {
					const table = document.getElementById(opts.tableId);
					const tbody = document.getElementById(opts.tbodyId);
					const searchInput = document.getElementById(opts.searchId);
					const pageSizeSelect = document.getElementById(opts.pageSizeId);
					const infoEl = document.getElementById(opts.infoId);
					const pagerEl = document.getElementById(opts.pagerId);

					if (!table || !tbody || !searchInput || !pageSizeSelect || !infoEl || !pagerEl) return;

					const allRows = Array.from(tbody.querySelectorAll('tr'));
					let filteredRows = allRows.slice();
					let page = 1;
					const extraFilterInputs = Array.isArray(opts.extraFilterInputIds)
						? opts.extraFilterInputIds.map(id => document.getElementById(id)).filter(Boolean)
						: [];

					function isEmptyStateRow(tr) {
						const tds = tr.querySelectorAll('td');
						return tds.length === 1 && (tds[0].getAttribute('colspan') || '') !== '';
					}

					const hasOnlyEmptyRow = allRows.length === 1 && isEmptyStateRow(allRows[0]);
					if (hasOnlyEmptyRow) {
						// Don't paginate the "No logs yet" row
						infoEl.textContent = '';
						pagerEl.innerHTML = '';
						return;
					}

					function getPageSize() {
						const n = Number(pageSizeSelect.value);
						return Number.isFinite(n) && n > 0 ? n : 10;
					}

					function applyFilter() {
						const q = (searchInput.value || '').trim().toLowerCase();
						filteredRows = allRows.filter(function (tr) {
							const matchesSearch = !q || tr.textContent.toLowerCase().includes(q);
							if (!matchesSearch) return false;
							if (typeof opts.rowMatchesFilter === 'function') {
								return opts.rowMatchesFilter(tr);
							}
							return true;
						});
						page = 1;
					}

					function render() {
						const pageSize = getPageSize();
						const total = filteredRows.length;
						const totalPages = Math.max(1, Math.ceil(total / pageSize));
						page = Math.min(page, totalPages);

						// Hide all, then show slice
						allRows.forEach(tr => { tr.style.display = 'none'; });

						const startIdx = (page - 1) * pageSize;
						const endIdx = Math.min(total, startIdx + pageSize);
						for (let i = startIdx; i < endIdx; i++) {
							filteredRows[i].style.display = '';
						}

						infoEl.textContent = total === 0
							? 'No matching rows.'
							: `Showing ${startIdx + 1}-${endIdx} of ${total}`;

						// Pager
						pagerEl.innerHTML = '';
						function addBtn(label, targetPage, disabled, active) {
							const li = document.createElement('li');
							li.className = 'page-item' + (disabled ? ' disabled' : '') + (active ? ' active' : '');
							const a = document.createElement('a');
							a.className = 'page-link';
							a.href = '#';
							a.textContent = label;
							a.addEventListener('click', function (e) {
								e.preventDefault();
								if (disabled) return;
								page = targetPage;
								render();
							});
							li.appendChild(a);
							pagerEl.appendChild(li);
						}

						addBtn('Prev', Math.max(1, page - 1), page === 1, false);

						const windowSize = 5;
						let start = Math.max(1, page - Math.floor(windowSize / 2));
						let end = Math.min(totalPages, start + windowSize - 1);
						start = Math.max(1, end - windowSize + 1);

						for (let p = start; p <= end; p++) {
							addBtn(String(p), p, false, p === page);
						}

						addBtn('Next', Math.min(totalPages, page + 1), page === totalPages, false);
					}

					searchInput.addEventListener('input', function () {
						applyFilter();
						render();
					});

					pageSizeSelect.addEventListener('change', function () {
						page = 1;
						render();
					});

					extraFilterInputs.forEach(function (inputEl) {
						const updateFn = function () {
							applyFilter();
							render();
						};
						inputEl.addEventListener('input', updateFn);
						inputEl.addEventListener('change', updateFn);
					});

					applyFilter();
					render();
				}

				setupTablePager({
					tableId: 'pwdLogsTable',
					tbodyId: 'pwdLogsTbody',
					searchId: 'pwdLogsSearch',
					pageSizeId: 'pwdLogsPageSize',
					infoId: 'pwdLogsInfo',
					pagerId: 'pwdLogsPager'
				});

				setupTablePager({
					tableId: 'seniorLogsTable',
					tbodyId: 'seniorLogsTbody',
					searchId: 'seniorLogsSearch',
					pageSizeId: 'seniorLogsPageSize',
					infoId: 'seniorLogsInfo',
					pagerId: 'seniorLogsPager'
				});

				setupTablePager({
					tableId: 'loginLogsTable',
					tbodyId: 'loginLogsTbody',
					searchId: 'loginLogsSearch',
					pageSizeId: 'loginLogsPageSize',
					infoId: 'loginLogsInfo',
					pagerId: 'loginLogsPager',
					extraFilterInputIds: ['loginLogsEmailFilter', 'loginLogsResultFilter', 'loginLogsDateFrom', 'loginLogsDateTo'],
					rowMatchesFilter: function (tr) {
						const emailFilter = (document.getElementById('loginLogsEmailFilter')?.value || '').trim().toLowerCase();
						const resultFilter = (document.getElementById('loginLogsResultFilter')?.value || '').trim().toLowerCase();
						const dateFrom = (document.getElementById('loginLogsDateFrom')?.value || '').trim();
						const dateTo = (document.getElementById('loginLogsDateTo')?.value || '').trim();

						const rowEmail = (tr.getAttribute('data-login-email') || '').toLowerCase();
						const rowDate = (tr.getAttribute('data-login-date') || '').trim();
						const rowResult = (tr.getAttribute('data-login-result') || '').toLowerCase();

						if (emailFilter && !rowEmail.includes(emailFilter)) return false;
						if (resultFilter && rowResult !== resultFilter) return false;
						if (dateFrom && (!rowDate || rowDate < dateFrom)) return false;
						if (dateTo && (!rowDate || rowDate > dateTo)) return false;
						return true;
					}
				});

				setupLoginDetailsModal();
			})();
		</script>
	</body>
</html>